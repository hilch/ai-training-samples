# Git repository ignore pattern
# B&R Automation Studio 6 projects with agentic engineering
# Includes unofficial considerations for Safety projects; versioning Safety
# projects is not officially supported.
#
# This .gitignore file serves as a starting point for Automation Studio 6 projects
# The file is meant to be placed in the root of the AS project (where the .apj file is)
# Otherwise, the starting "/" have to be adapted to match the actual structure of the repository

# -----------------------------------------------------------------------------
# B&R Automation Studio generated content
# These files and folders are created by Automation Studio and should not be versioned.
# The leading / assumes this file is next to the .apj file.
# -----------------------------------------------------------------------------

# AR versions are regenerated for the installed Automation Runtime
/AS/System/

# Build results
/Binaries/

# Debugging content, including online and trace data
/Diagnosis/**

# Optional: keep shared watch windows and task trace configurations.
# Git cannot re-include files below an ignored directory unless the directory
# itself is also re-included, which is why the first exception is required.
#!/Diagnosis/**/
#!/Diagnosis/**/*.PVM
#!/Diagnosis/**/*.tc

# Temporary files
/Temp/

# Upgrades are not part of the project source code
/Upgrades/

# Local Automation Studio user settings
/*.set
# Keep Safety-related .set files stored below Physical/.
!/Physical/**/*.set

# Marker created while the project is open in Automation Studio
/*.isopen

# -----------------------------------------------------------------------------
# Safety projects (optional, unofficial)
# Safety project versioning is not officially supported. Choose one strategy
# below, or remove these rules and version the complete Safety project.
# Uncomment only the strategy used by the project.
# -----------------------------------------------------------------------------

# mapp Safety: ignore generated CPU content but keep the required inputs.
#/Physical/*/*/mappSafety/*/C/PLC/R/CPU/*
#!/Physical/*/*/mappSafety/*/C/PLC/R/CPU/src.st1
#!/Physical/*/*/mappSafety/*/C/PLC/R/CPU/tmp.sto
#!/Physical/*/*/mappSafety/*/C/PLC/R/CPU/GLOBAL_VARIABLESTranslation_SF.xml

# Legacy Safety: ignore generated CPU content but keep the required inputs.
#/Physical/*/*/*/C/PLC/R/CPU/*
#!/Physical/*/*/*/C/PLC/R/CPU/src.st1
#!/Physical/*/*/*/C/PLC/R/CPU/tmp.sto
#!/Physical/*/*/*/C/PLC/R/CPU/GLOBAL_VARIABLESTranslation_SF.xml

# -----------------------------------------------------------------------------
# Archives
# Archives are normally distributed outside the source repository.
# If they must be versioned, use Git LFS and remove these rules.
# -----------------------------------------------------------------------------

*.zip
*.tar
*.7z

# -----------------------------------------------------------------------------
# Agentic engineering and development tooling (optional)
# Remove groups that are not part of the project's engineering workflow.
# -----------------------------------------------------------------------------

# Python caches, virtual environments, linter caches, and package metadata
__pycache__/
.venv/
.ruff_cache/
*.egg-info/

# Node.js dependencies and generated extension/tool builds
node_modules/
dist/
dist-sourcemaps/

# VS Code extension development: integration-test installations, dedicated
# debug profiles, and packaged extension installers. These are not generated
# merely by installing or using an extension.
.vscode-test/
.vscode-test-web/
.vscode-ext-debug/
*.vsix

# Generated simulation state and tool build caches
.simulation
.build

# Test coverage reports generated by JavaScript or Python test runners
coverage/

# -----------------------------------------------------------------------------
# Local and sensitive data
# -----------------------------------------------------------------------------

# Local secrets. Keep a committed .env.example with placeholder values.
.env
.env.*
!.env.example
*.token

# Playwright MCP browser profiles, traces, and session data
.playwright-mcp/

# Per-developer agent customizations. Shared agents, instructions, prompts,
# hooks, and skills remain trackable unless explicitly marked as local.
.agents/agents/*.local.md
.github/agents/*.local.md
.agents/agents/*.local.agent.md
.github/agents/*.local.agent.md
.agents/hooks/*.local.json
.github/hooks/*.local.json
.agents/instructions/*.local.instructions.md
.github/instructions/*.local.instructions.md
.agents/prompts/*.local.prompt.md
.github/prompts/*.local.prompt.md
.agents/skills/.local/
.github/skills/.local/

# -----------------------------------------------------------------------------
# Operating-system metadata
# -----------------------------------------------------------------------------

.DS_Store
Thumbs.db